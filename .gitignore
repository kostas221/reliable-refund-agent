# Secrets: never commit
.env

# Raw data stays out of git (provenance and checksum are recorded separately)
data/raw/

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
# Hypothesis keeps the failing sequences it found here and replays them first on the next run
.hypothesis/

# Local tools: the in-app browser's server list
.claude/launch.json

# The pilot dry run: requests written for reading, never sent
runs/pilot-dry-run/

# The screens: installed packages and builds stay out of git (package-lock.json pins the versions)
frontend/node_modules/
frontend/dist/

# Live-model sessions of the local server: every request in full, with what people typed; never committed
runs/live-*/
